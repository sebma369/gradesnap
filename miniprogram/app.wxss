page { height: 100%; background: #f4f7fb; color: #233550; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
view, input, button, picker, scroll-view { box-sizing: border-box; }
button::after { border: none; }
.page { height: 100%; display: flex; flex-direction: column; }
.card { background: #fff; border-radius: 24rpx; box-shadow: 0 8rpx 28rpx rgba(40, 83, 138, .055); }
.muted { color: #8795a9; }
.primary-button { background: #3979d8; color: #fff; border-radius: 20rpx; font-size: 30rpx; font-weight: 600; height: 90rpx; line-height: 90rpx; }
.primary-button[disabled] { background: #9ab9e5; color: #fff; }
.secondary-button { color: #3979d8; background: #edf4ff; border-radius: 18rpx; font-size: 28rpx; }
.section-title { font-size: 34rpx; font-weight: 700; color: #243956; }
.field-label { font-size: 25rpx; color: #8493a8; margin-bottom: 14rpx; }
