<view class="page">
  <view class="top-area">
    <view class="eyebrow">智能成绩录入</view>
    <view class="title">把纸上的成绩，轻松变成数据</view>
    <button class="upload-button" bindtap="chooseImage" disabled="{{busy}}">
      <text class="upload-icon">＋</text><text>拍摄 / 上传成绩表</text>
    </button>
    <view class="top-note">支持手写成绩表 · AI 识别后请逐项核对</view>
  </view>

  <scroll-view class="form-scroll" scroll-y enable-flex>
    <view class="form-content">
      <view wx:if="{{imagePath}}" class="image-card card" bindtap="previewImage">
        <image class="thumbnail" src="{{imagePath}}" mode="aspectFill" />
        <view class="image-info"><view class="image-name">{{imageFileID ? '已上传成绩表' : '成绩表预览（未上传）'}}</view><view class="image-hint">点击查看原图，方便校对</view></view>
        <view class="image-arrow">›</view>
      </view>
      <view class="section-heading"><text class="section-title">成绩信息</text><text class="section-caption">可随时修改</text></view>
      <view class="meta-card card">
        <view class="meta-field">
          <view class="field-label">考试日期</view>
          <picker mode="date" value="{{date}}" bindchange="onDateChange"><view class="picker-value">{{date}} <text class="chevron">⌄</text></view></picker>
        </view>
        <view class="meta-divider"></view>
        <view class="meta-field">
          <view class="field-label">科目</view>
          <input class="subject-input" value="{{subject}}" placeholder="请输入科目，如：数学" maxlength="30" bindinput="onSubjectInput" />
        </view>
      </view>
      <view class="section-heading score-heading"><text class="section-title">学生成绩</text><text class="section-caption">共 {{classSize}} 人</text></view>
      <view class="score-card card">
        <view class="score-header"><text>学号</text><text>成绩</text></view>
        <view wx:for="{{scores}}" wx:key="studentNo" class="score-row">
          <view class="student"><view class="student-badge">{{item.studentNo}}</view><text>学号 {{item.studentNo}}</text></view>
          <input class="score-input" type="digit" value="{{item.score}}" placeholder="—" data-index="{{index}}" bindinput="onScoreInput" />
        </view>
      </view>
      <view class="bottom-space"></view>
    </view>
  </scroll-view>
  <view class="bottom-area"><button class="primary-button" bindtap="save" disabled="{{busy}}">提交保存</button></view>
  <view wx:if="{{busy}}" class="busy-mask"><view class="busy-box"><view class="spinner"></view><text>{{busyText}}</text></view></view>
</view>
