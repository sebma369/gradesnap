.top-area { flex: none; padding: 28rpx 36rpx 25rpx; background: #f4f7fb; }
.eyebrow { color: #3979d8; font-size: 24rpx; font-weight: 600; letter-spacing: 2rpx; }
.title { color: #243956; font-size: 38rpx; font-weight: 700; margin: 12rpx 0 30rpx; }
.upload-button { display: flex; align-items: center; justify-content: center; height: 104rpx; border-radius: 22rpx; background: #3979d8; color: #fff; font-size: 31rpx; font-weight: 600; box-shadow: 0 10rpx 20rpx rgba(57, 121, 216, .18); }
.upload-icon { font-size: 44rpx; font-weight: 300; margin-right: 14rpx; line-height: 1; }
.upload-button[disabled] { background: #9ab9e5; color: #fff; }
.top-note { text-align: center; color: #94a2b3; font-size: 23rpx; margin-top: 18rpx; }
.form-scroll { flex: 1; min-height: 0; }
.form-content { padding: 12rpx 36rpx 0; }
.image-card { display: flex; align-items: center; padding: 16rpx; margin-bottom: 30rpx; }
.thumbnail { width: 82rpx; height: 82rpx; border-radius: 12rpx; background: #edf2f7; }
.image-info { flex: 1; margin-left: 18rpx; }.image-name { font-size: 28rpx; font-weight: 600; }.image-hint { color: #8b9bb0; font-size: 23rpx; margin-top: 7rpx; }.image-arrow { color: #a8b3c1; font-size: 42rpx; padding: 0 12rpx; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 16rpx 4rpx 18rpx; }.section-caption { color: #9aa7b7; font-size: 23rpx; }
.meta-card { padding: 26rpx 28rpx; }.meta-field { min-height: 102rpx; }.meta-divider { height: 1rpx; background: #edf1f5; margin: 12rpx 0 22rpx; }.picker-value, .subject-input { font-size: 31rpx; font-weight: 600; height: 52rpx; line-height: 52rpx; width: 100%; color: #243956; }.chevron { float: right; color: #a3afbe; }.subject-input { font-weight: 500; }
.score-heading { margin-top: 38rpx; }.score-card { padding: 0 28rpx; }.score-header { display: flex; align-items: center; color: #96a4b5; font-size: 24rpx; padding: 25rpx 0 14rpx; }.score-header .score-student, .score-header .score-value { text-align: center; }
.picker-placeholder { color: #a3afbe; font-weight: 400; }
.field-hint { color: #98a6b6; font-size: 23rpx; margin-top: 8rpx; }
.score-row { min-height: 100rpx; padding: 10rpx 0; display: flex; align-items: center; border-top: 1rpx solid #edf1f5; box-sizing: border-box; }.score-student { width: 180rpx; flex: none; }.score-raw { flex: 1; min-width: 0; text-align: center; }.score-value { width: 140rpx; flex: none; }.student { display: flex; align-items: center; font-size: 27rpx; color: #3a4e69; }.student-badge { width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center; border-radius: 14rpx; background: #eef4fd; color: #3979d8; font-size: 24rpx; font-weight: 600; margin-right: 16rpx; flex: none; }.raw-text { padding: 0 10rpx; box-sizing: border-box; color: #4e6685; font-size: 27rpx; font-weight: 600; line-height: 1.35; overflow-wrap: anywhere; }.raw-placeholder { color: #aeb9c7; font-weight: 400; }.score-input { height: 66rpx; border-radius: 14rpx; background: #f5f8fc; text-align: center; color: #243956; font-size: 30rpx; font-weight: 600; }
.bottom-space { height: 30rpx; }.bottom-area { flex: none; padding: 16rpx 36rpx; background: #fff; box-shadow: 0 -6rpx 18rpx rgba(40, 83, 138, .05); }
.busy-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 10; background: rgba(25, 42, 68, .22); display: flex; align-items: center; justify-content: center; }.busy-box { min-width: 300rpx; padding: 40rpx; border-radius: 22rpx; background: white; display: flex; flex-direction: column; align-items: center; font-size: 28rpx; }.spinner { width: 48rpx; height: 48rpx; border: 5rpx solid #d8e7fa; border-top-color: #3979d8; border-radius: 50%; animation: spin .7s linear infinite; margin-bottom: 22rpx; }@keyframes spin { to { transform: rotate(360deg); } }
