<view class="page">
  <view class="query-area">
    <view class="eyebrow">成绩档案</view><view class="heading">查询与导出</view>
    <view class="filter-card card">
      <view class="date-row"><view class="date-field"><view class="field-label">起始日期</view><picker mode="date" value="{{startDate}}" disabled="{{loading}}" bindchange="onStartChange"><view class="date-value">{{startDate}}</view></picker></view><view class="date-separator">至</view><view class="date-field"><view class="field-label">截止日期</view><picker mode="date" value="{{endDate}}" disabled="{{loading}}" bindchange="onEndChange"><view class="date-value">{{endDate}}</view></picker></view></view>
      <button class="secondary-button query-button" bindtap="query" loading="{{loading}}" disabled="{{loading}}">确定查询</button>
    </view>
  </view>
  <scroll-view class="result-scroll" scroll-y enable-flex>
    <view class="result-content">
      <view wx:if="{{queried && recordCount}}" class="result-heading"><text class="section-title">查询结果</text><text class="muted">{{recordCount}} 次记录 · {{scoreCount}} 条成绩</text></view>
      <view wx:if="{{queried && !recordCount}}" class="empty card"><view class="empty-icon">▤</view><view class="empty-title">当前日期范围暂无成绩记录</view><view class="empty-caption">调整日期后重新查询，或先到录入页保存成绩</view></view>
      <view wx:if="{{!queried && !loading}}" class="empty card"><view class="empty-icon">⌕</view><view class="empty-title">选择日期，查询成绩</view><view class="empty-caption">查询结果会在这里清晰展示</view></view>
      <view wx:for="{{records}}" wx:key="_id" class="record-card card">
        <view class="record-top"><view class="record-meta"><view class="record-date">{{item.date}}</view><view class="record-subject">{{item.subject}}</view><view wx:if="{{item.content}}" class="record-content">内容：{{item.content}}</view></view><view class="record-tag">{{item.scores.length}} 人</view></view>
        <view class="table-header"><text>学号</text><text>成绩</text></view>
        <view wx:for="{{item.scores}}" wx:for-item="score" wx:key="studentNo" class="table-row"><text>{{score.studentNo}}</text><text class="grade">{{score.score}}</text></view>
      </view>
      <view class="result-space"></view>
    </view>
  </scroll-view>
  <view class="bottom-area"><button class="primary-button" bindtap="exportFile" loading="{{exporting}}" disabled="{{!recordCount || loading || exporting}}">确认导出 Excel</button></view>
</view>
