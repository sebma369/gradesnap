.query-area { flex: none; padding: 28rpx 36rpx 24rpx; }.eyebrow { color: #3979d8; font-size: 24rpx; font-weight: 600; letter-spacing: 2rpx; }.heading { font-size: 40rpx; font-weight: 700; margin: 12rpx 0 26rpx; }.filter-card { padding: 28rpx; }.date-row { display: flex; align-items: center; }.date-field { flex: 1; min-width: 0; }.date-separator { color: #a2aebe; font-size: 24rpx; margin: 25rpx 18rpx 0; }.date-value { background: #f5f8fc; border-radius: 14rpx; padding: 20rpx 14rpx; text-align: center; font-size: 27rpx; color: #324761; white-space: nowrap; }.query-button { margin-top: 22rpx; height: 75rpx; line-height: 75rpx; }.result-scroll { flex: 1; min-height: 0; }.result-content { padding: 0 36rpx; }.result-heading { display: flex; justify-content: space-between; align-items: baseline; margin: 12rpx 4rpx 20rpx; }.result-heading .muted { font-size: 23rpx; }.record-card { margin-bottom: 22rpx; overflow: hidden; }.record-top { display: flex; justify-content: space-between; align-items: center; padding: 26rpx 28rpx; }.record-date { color: #8494a9; font-size: 23rpx; }.record-subject { font-size: 32rpx; font-weight: 700; margin-top: 6rpx; }.record-tag { padding: 9rpx 20rpx; background: #eaf2fd; color: #3979d8; border-radius: 30rpx; font-size: 23rpx; }.table-header, .table-row { display: flex; justify-content: space-between; padding: 16rpx 28rpx; font-size: 26rpx; }.table-header { background: #f8fafd; color: #95a4b5; font-size: 23rpx; }.table-row { border-top: 1rpx solid #f0f3f7; }.grade { font-weight: 700; color: #3979d8; }.empty { text-align: center; padding: 70rpx 24rpx; margin-top: 20rpx; }.empty-icon { color: #b8cbe4; font-size: 70rpx; }.empty-title { font-size: 29rpx; font-weight: 600; margin-top: 14rpx; }.empty-caption { color: #9aa8b8; font-size: 24rpx; margin-top: 12rpx; }.result-space { height: 24rpx; }.bottom-area { flex: none; padding: 16rpx 36rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; }
