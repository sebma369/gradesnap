<view class="entry-page">
  <view class="dialog">
    <view wx:if="{{classManagementEnabled}}" class="dialog-title">选择所属班级</view>
    <view wx:if="{{classManagementEnabled}}" class="warning">请谨慎选择自己的班级（可选多个）。确认后可在已选班级间切换，但不能自行增减。若没有目标班级，请联系管理员。</view>
    <view wx:if="{{loading}}" class="status">正在读取用户和班级信息…</view>
    <view wx:elif="{{loadError}}" class="status"><text>{{loadError}}</text><button class="retry-button" bindtap="loadSession">重新加载</button></view>
    <view wx:elif="{{classManagementEnabled && !classes.length}}" class="status"><text>暂无可选班级，请联系管理员创建班级。</text><button class="retry-button" bindtap="loadSession">重新加载</button></view>
    <block wx:elif="{{classManagementEnabled}}">
      <scroll-view class="class-list" scroll-y style="height:{{classListHeight}}rpx">
        <checkbox-group bindchange="onClassChange">
          <label wx:for="{{classes}}" wx:key="classId" class="class-option">
            <checkbox value="{{item.classId}}" color="#3979d8" disabled="{{saving}}" />
            <text class="class-label">{{item.className}}</text>
          </label>
        </checkbox-group>
      </scroll-view>
      <button class="join-button" bindtap="joinClass" disabled="{{!selectedClassIds.length || saving}}">{{saving ? '正在加入…' : '确认加入班级'}}</button>
    </block>
  </view>
</view>
