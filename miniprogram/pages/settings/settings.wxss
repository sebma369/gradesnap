.settings-content { flex: 1; padding: 46rpx 36rpx; }.eyebrow { color: #3979d8; font-size: 24rpx; font-weight: 600; letter-spacing: 2rpx; }.heading { font-size: 42rpx; font-weight: 700; margin-top: 12rpx; }.intro { color: #8493a8; font-size: 27rpx; line-height: 1.7; margin: 16rpx 0 36rpx; }.setting-card { padding: 34rpx; }.size-line { display: flex; align-items: center; font-size: 30rpx; font-weight: 600; }.size-input { width: 210rpx; height: 88rpx; background: #f5f8fc; border-radius: 16rpx; padding: 0 24rpx; margin-right: 20rpx; font-size: 36rpx; color: #243956; }.hint { color: #98a6b6; font-size: 24rpx; margin-top: 24rpx; }.tip-card { display: flex; align-items: flex-start; gap: 16rpx; color: #6480a1; background: #eaf2fd; border-radius: 18rpx; margin-top: 28rpx; padding: 26rpx; font-size: 25rpx; line-height: 1.6; }.tip-icon { flex: none; width: 32rpx; height: 32rpx; line-height: 32rpx; border-radius: 50%; background: #78a5e8; text-align: center; color: white; font-size: 22rpx; font-weight: 700; margin-top: 25rpx;}.bottom-area { flex: none; padding: 16rpx 36rpx; background: #fff; }
.settings-content { min-height: 0; }
.subjects-card { margin-top: 24rpx; }
.subject-add { display: flex; align-items: center; gap: 16rpx; }
.subject-input { flex: 1; min-width: 0; height: 80rpx; padding: 0 20rpx; background: #f5f8fc; border-radius: 14rpx; font-size: 28rpx; }
.add-button { flex: none; width: 112rpx; height: 80rpx; line-height: 80rpx; margin: 0; padding: 0; }
.subject-row { display: flex; align-items: center; gap: 16rpx; min-height: 82rpx; border-top: 1rpx solid #edf1f5; }
.subject-row:first-of-type { margin-top: 22rpx; }
.subject-name { flex: 1; min-width: 0; text-align: center; font-size: 28rpx; line-height: 1.5; color: #243956; }
.remove-button { flex: none; width: 112rpx; height: 64rpx; line-height: 64rpx; margin: 0; padding: 0; text-align: center; background: transparent; color: #d26969; font-size: 25rpx; }
